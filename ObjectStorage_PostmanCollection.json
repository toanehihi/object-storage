                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/files/{{file_id}}/download",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "files",
                "{{file_id}}",
                "download"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Delete File",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/files/{{file_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "files",
                "{{file_id}}"
              ]
            }
          },
          "response": []
        }
      ]
    }
  ],
